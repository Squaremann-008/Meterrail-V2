# Frontend configuration.
#
#   cp apps/web/.env.example apps/web/.env.local      (or: make env)
#
# Every variable here is NEXT_PUBLIC_*, meaning Next inlines it into the
# JavaScript bundle that ships to the browser. Nothing secret belongs in this
# file — app certificates, API tokens and private keys stay on the Go API.

# Base URL of the Go API. In production this is your nginx-fronted domain.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Dynamic environment id (https://app.dynamic.xyz -> Settings -> Developers).
# This one is public by design: it identifies the project, it does not
# authorise anything. Leave it empty to run the app signed-out.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Agora app id. Also public — joining a channel additionally requires a token
# minted by the API, which is what the app certificate signs.
NEXT_PUBLIC_AGORA_APP_ID=

# Hostname of the CDN in front of the R2 bucket, so next/image will serve
# uploaded media. Example: cdn.example.com
NEXT_PUBLIC_CDN_HOSTNAME=

# Shown in the header and the browser tab.
NEXT_PUBLIC_APP_NAME=Meterrail
