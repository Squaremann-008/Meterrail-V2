# Meterrail backend configuration.
#
#   cp .env.example .env      (or: make env)
#
# This file is read by the Go API, the worker and docker-compose. The frontend
# has its own file at apps/web/.env.example — NEXT_PUBLIC_* values are baked
# into the browser bundle and must never contain a secret.
#
# Values marked REQUIRED have no working default.

# =============================================================================
# Application
# =============================================================================
APP_NAME=meterrail-api
# development | staging | production. Production enables extra config
# validation and refuses to boot with a localhost CORS allowlist.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# text for local readability, json for production log aggregation
LOG_FORMAT=text

# =============================================================================
# HTTP server
# =============================================================================
PORT=8080
HTTP_HOST=0.0.0.0
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

# Comma-separated. Must list every origin the browser app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only enable behind a proxy you control (nginx, Cloudflare). When true the API
# trusts X-Forwarded-For for rate limiting, which is spoofable if exposed.
HTTP_TRUST_PROXY_HEADERS=false

# Per-user (or per-IP when anonymous) request budget.
HTTP_RATE_LIMIT_PER_MIN=120

# =============================================================================
# Database — Neon or Supabase (REQUIRED)
# =============================================================================
# Local docker-compose:
DATABASE_URL=postgres://meterrail:meterrail@localhost:5432/meterrail?sslmode=disable
#
# Neon:     postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/meterrail?sslmode=require
# Supabase: postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Both poolers cap connections well below a self-hosted server, so keep
# DB_MAX_OPEN_CONNS modest and let the pooler do the multiplexing.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_SLOW_QUERY_THRESHOLD=250ms

# Migrate on boot. Convenient locally; in production run `migrate` as a
# separate step before rolling the new containers (deploy.sh does this).
DB_AUTO_MIGRATE=true

# =============================================================================
# Redis — cache, rate limiting and the asynq job queue
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# Managed Redis with TLS: rediss://default:PASSWORD@host:6379
REDIS_CACHE_PREFIX=meterrail:cache
REDIS_POOL_SIZE=20

# =============================================================================
# Dynamic — web3 authentication (https://app.dynamic.xyz)
# =============================================================================
# Settings -> Developers -> API. Without this the API runs with authentication
# disabled and every protected endpoint returns 503.
DYNAMIC_ENVIRONMENT_ID=
# Derived from the environment id unless set explicitly.
DYNAMIC_JWKS_URL=
DYNAMIC_API_BASE=https://app.dynamicauth.com
# Server-side API token, for Dynamic's management API. Never expose this.
DYNAMIC_API_TOKEN=
# Optional extra JWT validation. Leave empty to skip the claim check.
DYNAMIC_JWT_ISSUER=
DYNAMIC_JWT_AUDIENCE=
DYNAMIC_JWKS_REFRESH_INTERVAL=1h
DYNAMIC_JWT_LEEWAY=30s

# Shared secret for the /v1/internal/* endpoints (queue stats, sync triggers).
# Generate one with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# =============================================================================
# Cloudflare R2 — object storage (S3-compatible)
# =============================================================================
# Dashboard -> R2 -> Manage API Tokens. Leaving these empty disables uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meterrail-media
# Derived from the account id unless set explicitly.
R2_ENDPOINT=
# Public bucket URL or a custom CDN domain. Leave empty for a private bucket,
# in which case downloads are served through presigned URLs instead.
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_PRESIGN_TTL=15m
# 25 MiB
R2_MAX_UPLOAD_BYTES=26214400

# =============================================================================
# Agora — realtime video and messaging (https://console.agora.io)
# =============================================================================
AGORA_APP_ID=
# The certificate signs join tokens. It must never reach the browser.
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=1h

# =============================================================================
# Envio — onchain indexer
# =============================================================================
# `make indexer` serves this locally on port 8080.
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
# Hasura admin secret; the local indexer's default is "testing".
ENVIO_ADMIN_SECRET=testing
ENVIO_TIMEOUT=10s
# How often the cron job mirrors new indexed events into Postgres.
ENVIO_SYNC_INTERVAL=1m
# Comma-separated chain ids to sync, matching indexer/config.yaml.
ENVIO_CHAIN_IDS=1,8453

# =============================================================================
# Background worker
# =============================================================================
WORKER_CONCURRENCY=10
# name:weight pairs — higher weights are dequeued more often.
WORKER_QUEUES=critical:6,default:3,low:1
WORKER_SHUTDOWN_TIMEOUT=30s
ASYNQMON_PORT=8081

# =============================================================================
# docker-compose only
# =============================================================================
POSTGRES_USER=meterrail
POSTGRES_PASSWORD=meterrail
POSTGRES_DB=meterrail
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
REDIS_MAXMEMORY=512mb
